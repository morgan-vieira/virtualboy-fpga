# Local
node_modules/
.ignore/
.local/
tools/

# Environment variables
.env

# Vendored reference emulators (re-fetch with pnpm run sync:repos).
# Must be .repos/* rather than .repos/ - git will not descend into an ignored
# directory, so the versions.json exception below would never be seen.
.repos/*
!.repos/versions.json

# Hide document file due to copyright purposes
docs/transcribed-documents/virtual-boy/licensed/
docs/technical-notes/virtual-boy/licensed/

# Disposable VS Code used by scripts/format-with-vscode.ts
.vscode-test/

# Python virtualenv and tool caches (recreate with requirements.txt)
.venv/
__pycache__/
.ruff_cache/

# Quartus build databases and outputs (regenerated on compile)
db/
incremental_db/
output_files/
greybox_tmp/
hc_output/
simulation/
.qsys_edit/

# Generated IP simulation models
*_sim/
*_sim.f

# Generated build ID (pre-flow script recreates these each build)
build_id.v
build_id.mif

# Generated IP metadata (the .qip/.sip/.v sources are kept)
*.bsf
*.ppf
*.spd

# Quartus reports / temp / programming artifacts
*.rpt
*.summary
*.smsg
*.done
*.jdi
*.pin
*.qws
*.qdf
*.sof
*.rbf
*.rbf_r
PLLJ_PLLSPE_INFO.txt
c5_pin_model_dump.txt

# Editor / patch junk
*.bak
*.orig
*.rej
*~

# Release archives (built by package.ps1 -Zip)
*.zip

# Assembled ROM blobs (copyrighted - never commit)
build/
*.rom

# Test ROM images (rebuilt from src/roms/ by pnpm run build:roms)
.roms/

# Compiled testbenches and waveform dumps (rebuilt by pnpm run test:sim)
.sim/